# Copy to .env for local dev. .env is gitignored - never commit a real key.
# On Netlify, set these under Project configuration -> Environment variables.

# --- Supabase (login + database) ---
# The two VITE_ values are safe in the browser. The secret key is server-only.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Comma-separated. These signed-in emails skip payment and can open /admin.
ADMIN_EMAILS=you@example.com

# --- AI (Gemini free tier first, same as the portfolio) ---
GEMINI_API_KEY=
# GROQ_API_KEY=
# LLM_PROVIDER=gemini
# AGENT_MODEL=

# --- Travel data ---
IGNAV_API_KEY=
LITEAPI_KEY=sand_...
UNSPLASH_ACCESS_KEY=

# --- Payments ---
# off = free beta for everyone, sandbox = Cashfree test checkout, live = real money (Cashfree production)
PAYMENTS_MODE=off
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
